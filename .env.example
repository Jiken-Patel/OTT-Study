# --- database ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=ott_study
DB_USER=ott
DB_PASSWORD=change_me

# --- experiment configuration (EXPERIMENTS.md) ---
AUTH_MODE=B                 # A | B | C | D
RATE_LIMIT_PROFILE=standard # standard | relaxed | off
PORT=3000
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters-1
JWT_REFRESH_SECRET=replace-with-a-different-32-plus-random-chars-2

# Mounts the simulated, non-destructive sensitive routes (confirm-email, update-security-settings).
# Needed for benchmark P2b and tests T11-T14. Off by default.
ENABLE_SIMULATED_OPERATIONS=false

# --- OOB sink (Config C only). The app gets the DELIVER key only; the harness uses the READ key. ---
# OOB_SINK_URL=http://127.0.0.1:4010
# OOB_SINK_KEY=replace-with-16-plus-chars-deliver-key
# OOB_SINK_PORT=4010                       # sink process only
# OOB_SINK_DELIVER_KEY=same-as-OOB_SINK_KEY # sink process only
# OOB_SINK_READ_KEY=different-read-key-16+  # sink process + test harness only, never the app

# --- test-only (rejected unless APP_PROFILE=test) ---
APP_PROFILE=development     # development | test
# OTT_EXPIRES_IN_SECONDS=2  # T06 only
# UNSAFE_NON_ATOMIC_CONSUME=false
# UNSAFE_DELAY_MS=0
